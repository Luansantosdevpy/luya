# Copie para .env (desenvolvimento) e cadastre as mesmas variáveis na Vercel
# (Project → Settings → Environment Variables).

# String de conexão do seu MongoDB (use um usuário só com readWrite no banco abaixo)
MONGODB_URI=mongodb://usuario:senha@seu-servidor:27017/luya?authSource=luya&tls=true

# Nome do banco (padrão: luya)
MONGODB_DB=luya

# Senha que a loja vai digitar para entrar na calculadora
APP_PASSWORD=troque-por-uma-senha-forte

# Segredo para assinar a sessão (mín. 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
